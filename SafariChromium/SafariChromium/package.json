{
  "name": "safari-chromium",
  "productName": "Safari",
  "version": "1.0.0",
  "description": "Safari-style privacy browser built on Chromium (Electron)",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:icon": "node tools/generate-icon.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.safari.chromium",
    "productName": "Safari",
    "protocols": [
      { "name": "HTTP", "schemes": ["http"] },
      { "name": "HTTPS", "schemes": ["https"] }
    ],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "Safari HTML document",
        "description": "HTML document opened in Safari",
        "role": "Viewer",
        "icon": "assets/safari.ico"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!tools/**"
    ],
    "asarUnpack": [
      "extensions/**"
    ],
    "win": {
      "icon": "assets/safari.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safari"
    }
  }
}
